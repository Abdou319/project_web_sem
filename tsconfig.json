{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@kg/core": [
        "packages/core/src"
      ],
      "@kg/visualization": [
        "packages/visualization/src"
      ],
      "@kg/ontology": [
        "packages/ontology/src"
      ],
      "@kg/rdf": [
        "packages/rdf/src"
      ],
      "@kg/sparql": [
        "packages/sparql/src"
      ],
      "@kg/reasoning": [
        "packages/reasoning/src"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "**/node_modules",
    "**/dist"
  ]
}